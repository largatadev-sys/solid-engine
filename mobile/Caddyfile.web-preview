# Static file serving for the founders' web preview (S0.4) — see Dockerfile.web-preview.
#
# Railway terminates TLS at its edge and hands the container plain HTTP on $PORT, so this listens on
# HTTP only. `auto_https off` stops Caddy from trying to provision its own certificate for a domain
# it does not own the DNS for — without it, Caddy would attempt ACME and fail on boot.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# S4.29 — a chat platform's crawler asking for an invite link gets the backend's per-trip Open
	# Graph tags; every other user agent keeps the SPA exactly as before. The card cannot be served
	# from here: a crawler executes no JavaScript, so the tags must already be in the HTML, and this
	# export ships ONE index.html for every route (web.output "single").
	#
	# The list is curated rather than a catch-all `bot` pattern, because a false positive costs a
	# human the app: they would get this branded stub instead of the product, with no way back except
	# the link in it. Adding a platform later is one line, reviewable in git.
	#
	# ONE PLATFORM IS SEVERAL AGENTS. The founder found a link unfurling in a Facebook GROUP chat and
	# not in a direct message — same platform, same URL, different crawler. Meta documents a family,
	# and only `facebookexternalhit` was matched: `meta-externalfetcher` is the one that "fetches
	# individual links at a user's request", which is the shape of a link shared into a DM, and
	# `facebookcatalog`, `meta-externalagent`, `meta-externalads` and `meta-webindexer` all fell
	# through too. The whole family is matched now.
	#
	# What must NOT be matched is the token `facebook` on its own: Meta's IN-APP BROWSER is a HUMAN,
	# and it carries FBAN/FBAV/FB_IAB. Matching loosely would serve the stub to every person who taps
	# a link inside the Facebook or Instagram app — the exact false positive this list exists to
	# avoid. Verified: those three UAs still get the SPA.
	#
	# LARGATA_API_UPSTREAM must be host:port reachable from THIS container — on the local rung that
	# is the compose service name, not localhost, which inside a container is the container itself.
	#
	# BOTH branches are `handle` blocks, and that is load-bearing rather than stylistic. Caddy orders
	# directives by ITS OWN precedence table, not by their order in this file, and `try_files` is a
	# `rewrite` — which runs BEFORE `handle`. Left bare, it rewrote every crawler request to
	# /index.html before the matcher below was ever consulted, so the crawler silently got the SPA's
	# generic card: no error, no log line, a preview container that looked perfectly healthy. Wrapping
	# the SPA branch in its own `handle` makes the two mutually exclusive and settles the order.
	@crawler {
		path_regexp join ^/join/([^/?]+)/?$
		header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|facebot|meta-external(agent|fetcher|ads)|meta-webindexer|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot)
	}
	handle @crawler {
		rewrite * /v1/join/{re.join.1}/preview
		reverse_proxy {$LARGATA_API_UPSTREAM}
	}

	# Expo Router produces a single-page app: the browser asks for /itineraries/<uuid> directly on a
	# refresh or a shared link, and no such file exists on disk. Without this, that request 404s and
	# the preview looks broken in exactly the situation a founder is most likely to hit — pasting a
	# link to something they want to show someone.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}

	# The bundle's filenames are content-hashed by Metro, so they may be cached hard; index.html must
	# not be, or a founder keeps loading yesterday's app against today's API and reports ghosts.
	@html path *.html
	header @html Cache-Control "no-cache"

	# The preview is a public URL by design (access control is the empty dev sandbox behind it, per
	# the spec). These headers are not a substitute for that decision — they are the cheap floor:
	# no framing, no MIME sniffing, no referrer leakage to third parties.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
