# Static file serving for the founders' web preview (S0.4) — see Dockerfile.web-preview.
#
# Railway terminates TLS at its edge and hands the container plain HTTP on $PORT, so this listens on
# HTTP only. `auto_https off` stops Caddy from trying to provision its own certificate for a domain
# it does not own the DNS for — without it, Caddy would attempt ACME and fail on boot.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# S4.29 — EVERY request for an invite link is answered by the backend's per-trip Open Graph page,
	# whatever asked for it. The card cannot be served from here: this export ships ONE index.html
	# for every route (web.output "single"), baked at build time, so it cannot know which token was
	# asked for — and a crawler executes no JavaScript, so the tags must already be in the HTML.
	#
	# This replaced a curated crawler User-Agent allowlist. That list could only ever be a guess at
	# which platforms unfurl, and it guessed short: measured against deployed dev, 9 of 9 unlisted
	# agents fell through to the SPA's generic card — Applebot (iMessage), SkypeUriPreview (Teams,
	# Skype, Outlook), Bluesky, Mastodon, redditbot, and every plain HTTP client, which is what every
	# third-party Open Graph validator uses. Answering per-trip by default deletes the guess: a
	# platform that ships tomorrow is already handled, and nothing has to be noticed to keep working.
	#
	# HUMANS ARE HANDED OFF BY THE PAGE ITSELF, which carries a one-line script following its own
	# "Open this invite" anchor — the same link plus `app=1`. Crawlers run no JavaScript, so they
	# read the tags and stop; a browser lands on the SPA one hop later, and a browser with scripting
	# off sees the anchor as a button. `app=1` is what breaks the loop, so this matcher MUST exclude
	# it: without that exclusion the hand-off arrives back here and bounces forever. og:url stays the
	# clean link, and the app strips `app=1` from the address bar on arrival, so a URL copied from
	# there still unfurls for whoever it is pasted to.
	#
	# LARGATA_API_UPSTREAM must be host:port reachable from THIS container — on the local rung that
	# is the compose service name, not localhost, which inside a container is the container itself.
	#
	# BOTH branches are `handle` blocks, and that is load-bearing rather than stylistic. Caddy orders
	# directives by ITS OWN precedence table, not by their order in this file, and `try_files` is a
	# `rewrite` — which runs BEFORE `handle`. Left bare, it rewrote every invite request to
	# /index.html before the matcher below was ever consulted, so the wrong card was served with no
	# error, no log line, and a preview container that looked perfectly healthy at every other layer.
	@invite {
		path_regexp join ^/join/([^/?]+)/?$
		not query app=1
	}
	# TWO fallbacks are needed here and they catch different things — `handle_errors` alone is not
	# enough, which is a trap worth naming because it looks sufficient. `reverse_proxy` treats an
	# upstream 404 as a legitimate RESPONSE, not an error, so it passes straight through: a mistyped
	# or deleted invite link rendered the backend's raw JSON instead of the app's dead postcard.
	# `handle_response` is what intercepts by STATUS; `handle_errors` below covers the other case,
	# an upstream Caddy cannot reach at all. The e2e spec's garbage-token walk is the guard.
	# UPSTREAM SHAPE MATTERS, and the failure is silent. Caddy forwards the ORIGINAL Host to the
	# upstream — verified against an echo server: a request for founders.largata.com arrives at the
	# backend carrying `Host: founders.largata.com`, not the upstream's own name. That is fine for an
	# upstream addressed by internal DNS (a compose service name locally, *.railway.internal on a
	# deployed rung), because routing there is by name and Host is ignored.
	#
	# It breaks if this is ever pointed at a PUBLIC HTTPS endpoint (say https://api-dev.largata.com):
	# the platform edge routes by Host, receives the preview's hostname instead of the API's, and
	# misroutes. The fix, if that day comes, is one line inside this block —
	# `header_up Host {upstream_hostport}` — deliberately NOT added today, because it would defend a
	# configuration nothing uses. Relevant when preprod and prod are stood up.
	#
	# WHAT CHANGED THE STAKES: this note was written when only CRAWLERS were proxied, and said the
	# failure would read as a broken feature. Every invite open is proxied now, so a misaddressed
	# upstream is every traveler failing to open an invite — with `handle_response` and
	# `handle_errors` below quietly serving the SPA over the top, which is exactly the shape that
	# hides it. Check this before pointing LARGATA_API_UPSTREAM at anything public.
	handle @invite {
		rewrite * /v1/join/{re.join.1}/preview
		reverse_proxy {$LARGATA_API_UPSTREAM} {
			@unrenderable status 4xx 5xx
			handle_response @unrenderable {
				rewrite * /index.html
				file_server
			}
		}
	}

	# Expo Router produces a single-page app: the browser asks for /itineraries/<uuid> directly on a
	# refresh or a shared link, and no such file exists on disk. Without this, that request 404s and
	# the preview looks broken in exactly the situation a founder is most likely to hit — pasting a
	# link to something they want to show someone.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}

	# The bundle's filenames are content-hashed by Metro, so they may be cached hard; index.html must
	# not be, or a founder keeps loading yesterday's app against today's API and reports ghosts.
	@html path *.html
	header @html Cache-Control "no-cache"

	# The backend is now on the path for every invite open, so its failure must not be. Any error the
	# site produces — an unreachable upstream, an unknown token's 404 — serves the SPA instead, which
	# is exactly what this container did before the flip: the app loads and reports the problem
	# itself. The status is forced to 200 because some in-app browsers replace a 5xx body with their
	# own error page, which would turn a degraded card into a dead invite link.
	handle_errors {
		rewrite * /index.html
		file_server {
			status 200
		}
	}

	# The preview is a public URL by design (access control is the empty dev sandbox behind it, per
	# the spec). These headers are not a substitute for that decision — they are the cheap floor:
	# no framing, no MIME sniffing, no referrer leakage to third parties.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
