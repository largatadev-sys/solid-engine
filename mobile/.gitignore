# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Sourced trip fixtures — third-party photos, fetched on demand by scripts/fetch-fixtures.js.
# Not committed: they are megabytes of images this repo does not own, and the fetcher is
# reproducible. CREDITS.json travels with them locally so attribution is never guessed.
scripts/fixtures/photos/

# Playwright artifacts (H1)
e2e/.artifacts/
playwright-report/

# TypeScript incremental build cache (H2 ticket 04) — a build artifact must be unstageable,
# not merely un-staged.
*.tsbuildinfo
