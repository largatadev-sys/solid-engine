# Copy to .env and adjust. `.env` is gitignored and must never be committed (CLAUDE.md).
#
# This file carries PLACEHOLDERS ONLY — never a real credential, even a local one that "doesn't
# matter". Real values live in .env locally and in the platform's env-var UI in prod.
#
# Every value below has a working default in docker-compose.yml, so `docker compose up` works
# with no .env at all. Copy this file only when you need to change something.

# --- Postgres (local stack) -------------------------------------------------------------
# Local-dev values for an ephemeral database that is wiped on every `docker compose down`.
POSTGRES_DB=largata
POSTGRES_USER=largata
POSTGRES_PASSWORD=<local-dev-password>
POSTGRES_PORT=5432

# --- Object storage (S3.3, ADR-021) -----------------------------------------------------
# Local dev runs GARAGE as the S3-class emulator (compose swapped it from MinIO at S3.3: MinIO
# stopped publishing community images in Oct 2025 and archived the repo). The bucket and its key
# are minted from these values at container start — fresh bucket every redeploy, matching the
# database's fresh-DB contract.
#
# These are local-dev credentials for an emulator that holds nothing real. The DEPLOYED rungs use
# the same four backend variables (LARGATA_STORAGE_*) pointed at Railway Buckets or R2, and those
# ARE real credentials — they live in the platform's env-var UI, never here.
# The access key must be at least 8 characters or Garage refuses to boot.
STORAGE_BUCKET=largata-media
STORAGE_ACCESS_KEY=largata-local
STORAGE_SECRET_KEY=<local-dev-password>
STORAGE_PORT=3900
STORAGE_ADMIN_PORT=3903

# What the backend points at. Defaults to the compose emulator; unset it (or run outside compose)
# and the backend binds UnconfiguredObjectStore, which refuses media with a 503 rather than
# reporting an upload it cannot deliver. Everything except photos still works.
LARGATA_STORAGE_ENDPOINT=http://storage:3900

# --- Backend ----------------------------------------------------------------------------
BACKEND_PORT=8080

# --- Transactional mail: Resend (S1.2 invitations, S4.0 verification codes) --------------
# A REAL CREDENTIAL. It lives in .env locally and in the platform's env-var UI on deployed
# rungs — never in a committed file, and never echoed into a shell command (it lands in
# history and in the transcript of whoever is watching).
#
# Leave it unset and the backend binds a LOGGING SINK instead: the mail is written to the
# backend log rather than the wire. That is the normal local posture, and it is how a local
# run reads a verification code without an inbox. A BLANK value selects the sink too — set
# deliberately, because a blank key binding the real mailer would 401 every send while the
# configuration looked correct (InvitationMailerBindingTest pins both halves).
LARGATA_RESEND_API_KEY=<resend-api-key-sending-access-only>

# Any address at the Resend-verified domain. The apex largata.com is verified (DKIM at
# resend._domainkey.largata.com; send.largata.com carries the SES return-path MX + SPF), so
# the backend's default of invites@largata.com already works and this only needs setting to
# use a different sender.
LARGATA_RESEND_FROM=invites@largata.com

# --- Firebase Admin SDK: the email-verification seam (S4.0) ------------------------------
# A REAL CREDENTIAL — a service-account private key for the largata-dev Firebase project
# (identify it by NUMBER, 309534715609, per the S0.6 phantom-project trap). The one thing it
# authorises is flipping `email_verified` on a Firebase user after the traveler types the
# right 6-digit code; ADR-006's posture is otherwise unchanged. Never committed: the download
# is gitignored by both of its real filenames, and this value lives only in .env and in the
# platform's env-var UI.
#
# Two accepted shapes, told apart by the leading '{':
#   1. INLINE JSON (the documented default) — the same mechanism as the deployed rung, where
#      Railway's UI holds a value rather than a file. Minify the download to one line:
#        jq -c . backend/largata-dev-firebase-adminsdk-*.json
#      then paste the result after the '=' below, unquoted, on a single line.
#   2. A FILESYSTEM PATH the backend process can read. Inside the compose container that means
#      a path you have mounted yourself; the host path of the download will not resolve.
#
# Leave it UNSET and the backend binds UnconfiguredEmailVerificationFlag, which REFUSES with
# 503 rather than reporting a verification it cannot deliver. That is the correct posture for
# a rung without the credential — everything except email verification still works.
LARGATA_FIREBASE_CREDENTIALS=<minified-service-account-json-or-a-readable-path>

# --- Feedback reports: the worklog relay (FB-1) ------------------------------------------
# Where accepted reports are relayed, server-to-server, into worklog's Reports intake.
#
# Leave BOTH unset and the backend binds a LOGGING SINK: the report is written to the backend
# log and its outbox row marked delivered, touching worklog not at all. That is the normal
# local and CI posture, and it is deliberate — worklog's Reports are PERMANENT and have no
# delete, so a walk or a smoke run that reached the real inbox would deposit junk nobody can
# remove. The URL is what selects the real relay; a blank URL selects the sink.
#
# The secret is a REAL CREDENTIAL and is deliberately DIFFERENT per environment (dev↔dev,
# prod↔prod). It lives in .env locally and in the platform's env-var UI on deployed rungs —
# never in a committed file, and never echoed into a shell command (it lands in history and in
# the transcript of whoever is watching).
#
# Intake URLs: dev  https://largata-ts-dev.up.railway.app/api/intake/reports
#              prod https://worklog.largata.com/api/intake/reports
# Point a LOCAL stack at the DEV url only for the one sanctioned live check, and never at prod.
LARGATA_REPORTS_INTAKE_URL=<worklog-intake-url-or-leave-unset-for-the-logging-sink>
LARGATA_REPORTS_INTAKE_SECRET=<worklog-intake-shared-secret>

# --- Mobile -----------------------------------------------------------------------------
# These belong in `mobile/.env` (Expo reads its own), not the root .env.
#
# The backend base URL the Expo app calls. On the Android emulator, 10.0.2.2 is the host
# machine's loopback — localhost would resolve to the emulator itself.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Google sign-in's WEB client id — not the Android one. Firebase verifies the Google token
# against the web OAuth client it auto-created when Google sign-in was enabled in the console;
# without this, signIn() returns a null idToken and the exchange fails with nothing naming the
# cause (S0.2). Find it in the gitignored mobile/google-services.json under
# client[0].oauth_client, the entry with "client_type": 3.
#
# ONE client id, BOTH doorways (S0.6): native uses it for the token exchange above; the web
# preview's Google Identity Services uses it to mint the credential in the first place. That is
# why the same value is also a build arg in Dockerfile.web-preview.
#
# What guards it is not secrecy (an OAuth client id ships in every APK and every web bundle) but
# the client's AUTHORIZED JAVASCRIPT ORIGINS list in the Google Cloud console: every browser
# origin that renders the Google button must be registered there — founders.largata.com and the
# local preview origin (http://localhost:8081) — or GIS refuses to render and the flow dies with
# an origin_mismatch that reads like a code bug. It lives in .env because it is per-environment
# config, and the prod Firebase project will have a different one.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<from-google-services-json-client_type-3>

# --- Web preview only (S0.4) ------------------------------------------------------------
# The founders' browser preview (interim — see the S0.4 spec) runs the Firebase *JS* SDK, which
# takes a config object rather than the google-services.json the native builds read. Same
# per-environment regime, different transport: these are the values from the Firebase console →
# largata-dev → Project settings → Your apps → Web app.
#
# Not secrets. A Firebase web apiKey identifies the project to Google's endpoints and authorizes
# nothing — it ships inside every web bundle by construction, exactly as the OAuth client id above
# ships in every APK. What guards the project is the authorized-domains list and the security
# rules, not this value's secrecy. They live here because they are per-environment config.
#
# Only needed to run/export the web build; the native app ignores them entirely.
EXPO_PUBLIC_FIREBASE_API_KEY=<web-app-config-apiKey>
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=largata-dev
EXPO_PUBLIC_FIREBASE_APP_ID=<web-app-config-appId>

# --- Backend CORS (dev environment only) ------------------------------------------------
# Exact browser origins the dev backend answers (DevCorsConfig, @Profile("dev")). Defaults cover
# Expo's local web server, so local dev needs nothing here. The deployed dev environment adds the
# preview's origin — set in Railway's UI, never in the repo. Never "*": prod/preprod run no profile
# and have no CORS at all, and this list must not become the exception that erodes that.
LARGATA_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
