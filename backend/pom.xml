<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Versions are BOM-managed on purpose (spec: "BOM-first, never hand-pick what the BOM
    coordinates"). Boot 4.1.0's BOM supplies Testcontainers 2.0.5 and JUnit Jupiter 6.0.3,
    which satisfies the Testcontainers 2.x floor without an override.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.largata</groupId>
  <artifactId>backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>largata-backend</name>
  <description>Largata backend — modular monolith (Spring Boot)</description>

  <properties>
    <java.version>25</java.version>
    <firebase-admin.version>9.4.3</firebase-admin.version>
    <awssdk.version>2.51.1</awssdk.version>
  </properties>

  <!--
    The AWS SDK publishes its own BOM and Boot's parent does not manage it (no software.amazon.awssdk
    coordinate exists in Boot 4.1's managed list), so this is the one place a version is named. Import
    it rather than pinning `s3` directly: the SDK's modules must move in lockstep, and the BOM is how
    that is expressed.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      WS-1 (ADR-030). Boot 4 keeps WebSocket support in its own starter; spring-boot-starter-web
      alone carries no WebSocketHandler, no handshake plumbing and no WebSocketConfigurer, so a
      @Configuration implementing it is silently never applied. Same family as the Flyway-starter
      trap below: the app boots green and the feature simply does not exist.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!--
      Bean Validation (S0.3). Without this starter @Valid is inert — no validator on the classpath
      means the annotation is silently ignored and a blank title reaches the domain, where it throws
      IllegalArgumentException and surfaces as a 500. The failure looks like "validation doesn't
      work" and is invisible until something invalid is actually sent.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      Boot 4 moved Flyway's auto-configuration into its own module: flyway-core alone is on the
      classpath but never runs (no autoconfig class ships with spring-boot-data-jpa). The starter
      is the paved road — it brings flyway-core plus the autoconfiguration.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Resource server, not the full auth-server story: Firebase owns credentials and signs the
      tokens (ADR-006); this app only validates them, offline, against Google's published JWKS.
      Request-path validation still never calls the issuer — the Admin SDK below is used on ONE
      code path only (S4.0's verification confirm), never per request.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!--
      Firebase Admin SDK (S4.0 ticket 02, spec decision 2). The ONE thing it does here is flip
      `email_verified` on a Firebase user after the traveler proves inbox control with a 6-digit
      code — a write to the identity provider, which a resource server cannot do with a JWKS.
      ADR-006's posture is unchanged and deliberately guarded: the whole dependency lives behind
      `EmailVerificationFlag`, one interface with one method, so "swap the identity provider" stays
      a bounded edit rather than a hunt. Version is pinned explicitly — Boot's BOM does not manage
      it, so there is no version to inherit.
    -->
    <dependency>
      <groupId>com.google.firebase</groupId>
      <artifactId>firebase-admin</artifactId>
      <version>${firebase-admin.version}</version>
    </dependency>
    <!--
      A TRAP THIS STORY WALKED INTO, RECORDED SO NOBODY REPEATS IT.

      firebase-admin drags Apache HttpClient 5 in transitively, and Spring picks its
      ClientHttpRequestFactory by CLASSPATH DETECTION rather than configuration. So merely adding
      the Admin SDK swapped the transport under every RestClient and RestTestClient in the
      application - and HttpClient 5's default retry strategy RETRIES 503. The first symptom was an
      unrelated test (HealthUnavailableIT) reporting the same outage logged twice and taking 3x as
      long; nothing pointed at a dependency.

      The obvious fix - excluding httpclient5 - is WRONG and looks right: the exclusion builds, the
      unit tests pass, and the application then dies at startup with
      `NoClassDefFoundError: org/apache/hc/client5/http/nio/AsyncClientConnectionManager` from
      FirebaseOptions' constructor, because ApiClientUtils.getDefaultTransport() probes for the
      HTTP/2 transport unguarded. Only `docker compose up` surfaces that (S0.2's getTokens() shape:
      green everywhere except the environment that ships). FirebaseAdminSdkBootTest now covers it.

      So the dependency STAYS and the side effect is neutralised where we own the client instead:
      ResendMailTransport and the ITs that care both name their request factory explicitly.
    -->

    <!--
      S3-class object storage (S3.3, ADR-021). The AWS SDK is the client for EVERY target we may
      point at — Garage locally, Railway Buckets or Cloudflare R2 deployed — which is the whole
      reason the provider is swappable by configuration. The MinIO SDK was rejected at the ticket:
      it is maintained by a vendor mid-retreat from open source and drags OkHttp + the Kotlin
      stdlib in as a second HTTP stack.

      THE EXCLUSIONS ARE LOAD-BEARING, NOT TIDINESS. `s3` pulls BOTH apache-client (HttpClient 4.x)
      and netty-nio-client at runtime scope even when only the sync client is used. We exclude both
      and state url-connection-client explicitly, for the reason recorded on firebase-admin above:
      Spring picks its ClientHttpRequestFactory by CLASSPATH DETECTION, so an HTTP stack arriving
      transitively rewires transports the storage code never touches. Two specific consequences:

        1. NEVER add `apache5-client` (the SDK's HttpClient 5.x option, and a future default). It
           would put HttpClient 5 back on the classpath and re-flip every RestClient onto it —
           precisely the S4.0 trap, whose first symptom was an unrelated test getting slower.
        2. Every SDK client must name its httpClientBuilder. With one client on UrlConnection and
           another defaulting, the SDK throws "multiple HTTP implementations found on the classpath"
           — the same discipline as ResendMailTransport.statedTransport().
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <!--
      Image ingest (INV-11). A single jar with zero transitive dependencies, wrapping ImageIO — so
      decode-validation and metadata-stripping come from the JDK unchanged (a BufferedImage holds
      pixels only, so re-encoding drops EXIF by construction; PRESERVING metadata is what would
      need a library). The one thing ImageIO cannot do is honour EXIF orientation, and that is the
      whole reason this dependency exists: strip the tag off an unrotated pixel grid and the photo
      is permanently sideways.
    -->
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.21</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Not used yet, and deliberately kept: the spec planned `jwt()` slice tests for endpoints where
      auth is context rather than subject. S0.2 has one endpoint and auth *is* its subject, so every
      test here mints a real token through the real chain (TestJwtSupport) — a slice test would
      prove less. The first S0.3 controller with domain logic behind auth is where this earns its
      place. Remove it if S0.3 finds it still unused.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x renamed every module artifact: `postgresql` -> `testcontainers-postgresql`,
      `junit-jupiter` -> `testcontainers-junit-jupiter` (the 1.x names 404 at 2.0.5). Versions still
      come from the BOM, which Boot's parent imports at ${testcontainers.version}.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The storage IT's emulator. MinIO rather than Garage here — deliberately different from the
      compose stack, and the difference is the point: the SDK code is identical against both, so
      running the ITs on a second implementation is free evidence that nothing has quietly grown a
      dependency on one vendor's behaviour. The image tag is pinned explicitly (MinIOContainer's
      default tag would resolve against an archived repository — MinIO stopped publishing community
      images in Oct 2025).
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-minio</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      PL-2. The module-boundary pilot (ADR-002). `place` is born with its boundary ENFORCED rather
      than documented, because the alternative is what `itinerary` became: 80 classes nothing stops
      anyone reaching into. Written the one day it is certainly true — a boundary test added later
      has to be argued past every violation that accumulated meanwhile.

      Version pinned by hand: ArchUnit is not in the Spring Boot BOM, so there is nothing to inherit
      from (unlike every Testcontainers artifact above).
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Integration tests (*IT) run in `verify`, after the app is packaged. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
